---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { site, CATEGORIES, clients } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const itemsFor = (key: string) => work.filter((w) => w.data.category === key);
/* how many tiles are visible at once on desktop; arrows appear past this */
const PER_VIEW = 3;
---

<Base title={`${site.name}: ${site.role}, ${site.location}`} bodyClass="b-index">
  <SiteHeader current="home" />
  <Hero />

  <!-- ============ SELECTED WORK ============ -->
  <main class="work wrap" id="work">
    <p class="eyebrow">Selected work: click any category to explore</p>

    <div class="acc" id="acc">
      {CATEGORIES.map((c, i) => {
        const items = itemsFor(c.key);
        const scrolls = items.length > PER_VIEW;
        return (
          <section class="acc-item" data-cat={c.key}>
            <h2 class="acc-h">
              <button class="acc-btn" id={`acc-btn-${c.key}`} aria-expanded="false" aria-controls={`acc-panel-${c.key}`}>
                <span class="acc-ico"><CategoryIcon name={c.icon} /></span>
                <span class="acc-title">{c.label}</span>
                <span class="acc-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </button>
            </h2>
            <div class="acc-panel" id={`acc-panel-${c.key}`} role="region" aria-labelledby={`acc-btn-${c.key}`} hidden>
              <div class="acc-panel-in">
                <div class:list={['rail-wrap', { scrolls }]}>
                  <button class="rail-btn rail-prev" type="button" aria-label={`Scroll ${c.label} left`} disabled>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                  </button>
                  <div class="rail" tabindex={scrolls ? 0 : undefined} aria-label={`${c.label} projects`}>
                    {items.map((entry, j) => {
                      const w = entry.data;
                      return (
                        <a class:list={['tile', { wide: w.wide }]} href={`/work/${entry.id}/`}>
                          <img src={w.image} alt="" loading={i === 0 && j < 3 ? 'eager' : 'lazy'} decoding="async" width="1200" height="900" />
                          {w.video && <span class="tile-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.14v13.72L19 12 8 5.14Z"/></svg></span>}
                          <span class="tile-cap">
                            <span class="tile-title">{w.caption ?? w.title}</span>
                            <span class="tile-go">View project →</span>
                          </span>
                        </a>
                      );
                    })}
                    {items.length === 0 && <p class="rail-empty">Work for this category is coming soon.</p>}
                  </div>
                  <button class="rail-btn rail-next" type="button" aria-label={`Scroll ${c.label} right`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </button>
                </div>
                {scrolls && <p class="rail-count"><span class="rail-pos">1</span> / {items.length}</p>}
              </div>
            </div>
          </section>
        );
      })}
    </div>
  </main>

  <!-- ============ CLIENTS ============ -->
  <section class="clients wrap" id="clients">
    <p class="eyebrow">Clients I worked with</p>
    <ul class="logo-grid">
      {clients.map((c) => (
        <li class="logo"><img src={`/images/clients/${c.file}`} alt={c.name} loading="lazy" decoding="async" width="480" height="240" /></li>
      ))}
    </ul>
  </section>

  <SiteFooter />
</Base>

<style>
  /* ---- work accordion ---- */
  .work{padding-bottom:clamp(64px,9vw,120px)}
  .acc{margin-top:26px;border-top:1px solid var(--line)}
  .acc-item{border-bottom:1px solid var(--line)}
  .acc-h{font-size:inherit;font-weight:inherit;line-height:inherit}
  .acc-btn{width:100%;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:0 24px;padding:26px 8px 26px 26px;text-align:left}
  .acc-btn:hover .acc-title{color:var(--accent)}
  .acc-ico{display:inline-flex;color:var(--ink-faint);width:20px;transition:color .2s}
  .acc-ico :global(.cat-ico){width:20px;height:20px}
  .acc-title{font-family:var(--font-display);font-size:clamp(19px,2vw,23px);font-weight:400;transition:color .2s}
  .acc-arrow{width:50px;height:50px;border:1px solid var(--ink-soft);border-radius:50%;display:grid;place-items:center;color:var(--ink);transition:background .25s,border-color .25s,color .25s,transform .35s ease}
  .acc-arrow svg{width:16px;height:16px}
  .acc-item.open .acc-arrow{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);transform:rotate(90deg)}
  .acc-item.open .acc-ico{color:var(--accent)}
  .acc-item.open .acc-title{color:var(--ink)}
  .acc-btn:hover .acc-arrow{border-color:var(--accent);color:var(--accent)}
  .acc-item.open .acc-btn:hover .acc-arrow{color:var(--accent-ink)}

  .acc-panel{background:var(--paper-2);overflow:hidden;height:0;transition:height .4s cubic-bezier(.4,0,.2,1)}
  .acc-panel[hidden]{display:block;height:0}
  .acc-panel-in{padding:26px 0}

  /* ---- horizontal rail ---- */
  .rail-wrap{position:relative;--gap:16px;--per:3}
  .rail{display:flex;gap:var(--gap);overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:2px}
  .rail::-webkit-scrollbar{display:none}
  .rail:focus-visible{outline-offset:6px}
  .tile{position:relative;flex:0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per));aspect-ratio:4/3;overflow:hidden;background:var(--paper-3);border-radius:2px;scroll-snap-align:start;box-shadow:0 1px 0 rgba(0,0,0,.04)}
  .tile.wide{flex-basis:calc((100% - (var(--per) - 1) * var(--gap)) / var(--per) * 2 + var(--gap))}
  .tile img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .tile:hover img,.tile:focus-visible img{transform:scale(1.03)}
  .tile-cap{position:absolute;left:0;right:0;bottom:0;padding:26px 20px 14px;display:flex;justify-content:space-between;align-items:baseline;gap:12px;color:#fff;background:linear-gradient(180deg,transparent,rgba(0,0,0,.6));text-shadow:0 1px 2px rgba(0,0,0,.4)}
  .tile-title{font-size:13px;font-weight:500}
  .tile-go{font-size:11px;letter-spacing:.08em;opacity:0;transform:translateX(-4px);transition:opacity .25s,transform .25s;white-space:nowrap}
  .tile:hover .tile-go,.tile:focus-visible .tile-go{opacity:1;transform:none}
  .tile-play{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}
  .tile-play svg{width:52px;height:52px;padding:14px;border-radius:50%;background:rgba(255,255,255,.85);color:var(--ink)}
  .rail-empty{color:var(--ink-soft);font-size:14px}

  /* arrows: shown only when the rail actually overflows (JS toggles .has-overflow) */
  .rail-btn{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:44px;height:44px;border-radius:50%;background:var(--paper);border:1px solid var(--line);color:var(--ink);display:none;place-items:center;box-shadow:0 6px 18px rgba(0,0,0,.12);transition:background .2s,color .2s,border-color .2s,opacity .2s}
  .rail-btn svg{width:16px;height:16px}
  .rail-btn:hover{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
  .rail-btn:disabled{opacity:0;pointer-events:none}
  .rail-prev{left:14px}
  .rail-next{right:14px}
  .rail-wrap.has-overflow .rail-btn{display:grid}
  .rail-count{margin-top:12px;text-align:right;font-size:11px;letter-spacing:.14em;color:var(--ink-faint);font-variant-numeric:tabular-nums}

  @media (max-width:820px){
    .rail-wrap{--per:2}
    .acc-btn{padding-left:12px;gap:0 16px}
    .acc-arrow{width:42px;height:42px}
    .rail-prev{left:8px}.rail-next{right:8px}
  }
  @media (max-width:520px){
    .rail-wrap{--per:1.15}
    .tile.wide{flex-basis:calc((100% - (var(--per) - 1) * var(--gap)) / var(--per))}
    .rail-btn{width:38px;height:38px}
  }

  /* ---- clients ---- */
  .clients{padding-bottom:20px}
  .logo-grid{list-style:none;display:grid;grid-template-columns:repeat(6,1fr);gap:16px;margin-top:26px}
  .logo{border:1px solid var(--line-soft);aspect-ratio:1.36/1;display:grid;place-items:center;padding:18px;background:transparent;transition:background .2s,border-color .2s}
  .logo:hover{background:rgba(255,255,255,.35);border-color:var(--line)}
  .logo img{max-height:100%;width:100%;height:auto;object-fit:contain}
  @media (max-width:900px){.logo-grid{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:520px){.logo-grid{grid-template-columns:repeat(3,1fr);gap:10px}.logo{padding:10px}}
</style>

<script>
  /* ---------- accordion (one open at a time, animated height) ---------- */
  const items = Array.from(document.querySelectorAll<HTMLElement>('.acc-item'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setOpen(item: HTMLElement, open: boolean) {
    const btn = item.querySelector<HTMLButtonElement>('.acc-btn')!;
    const panel = item.querySelector<HTMLElement>('.acc-panel')!;
    const inner = panel.firstElementChild as HTMLElement;
    btn.setAttribute('aria-expanded', String(open));
    item.classList.toggle('open', open);
    if (open) {
      panel.hidden = false;
      updateRail(item);
      const h = inner.offsetHeight;
      if (reduce) { panel.style.height = 'auto'; return; }
      panel.style.height = '0px';
      requestAnimationFrame(() => { panel.style.height = h + 'px'; });
      panel.addEventListener('transitionend', function done(e) {
        if (e.target !== panel) return;
        panel.style.height = 'auto';
        panel.removeEventListener('transitionend', done);
      });
    } else {
      if (reduce) { panel.style.height = '0px'; panel.hidden = true; return; }
      panel.style.height = inner.offsetHeight + 'px';
      requestAnimationFrame(() => { panel.style.height = '0px'; });
      panel.addEventListener('transitionend', function done(e) {
        if (e.target !== panel) return;
        panel.hidden = true;
        panel.removeEventListener('transitionend', done);
      });
    }
  }

  items.forEach((item) => {
    item.querySelector('.acc-btn')!.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');
      items.forEach((o) => { if (o !== item && o.classList.contains('open')) setOpen(o, false); });
      setOpen(item, !isOpen);
      if (!isOpen) history.replaceState(null, '', `#${item.dataset.cat}`);
    });
  });

  /* ---------- horizontal rails: left/right buttons + position counter ---------- */
  function updateRail(item: HTMLElement) {
    const wrap = item.querySelector<HTMLElement>('.rail-wrap');
    const rail = wrap?.querySelector<HTMLElement>('.rail');
    if (!wrap || !rail) return;
    const overflow = rail.scrollWidth - rail.clientWidth > 4;
    wrap.classList.toggle('has-overflow', overflow);
    const prev = wrap.querySelector<HTMLButtonElement>('.rail-prev')!;
    const next = wrap.querySelector<HTMLButtonElement>('.rail-next')!;
    prev.disabled = rail.scrollLeft <= 4;
    next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    /* counter: index of the first visible tile */
    const pos = item.querySelector<HTMLElement>('.rail-pos');
    if (pos) {
      const tiles = Array.from(rail.querySelectorAll<HTMLElement>('.tile'));
      const first = tiles.findIndex((t) => t.offsetLeft + t.offsetWidth - rail.scrollLeft > 4);
      pos.textContent = String(Math.max(1, first + 1));
    }
  }
  function stepFor(rail: HTMLElement) {
    const t = rail.querySelector<HTMLElement>('.tile');
    const gap = parseFloat(getComputedStyle(rail).columnGap) || 16;
    return t ? t.offsetWidth + gap : rail.clientWidth * 0.8;
  }
  items.forEach((item) => {
    const wrap = item.querySelector<HTMLElement>('.rail-wrap');
    const rail = wrap?.querySelector<HTMLElement>('.rail');
    if (!wrap || !rail) return;
    const behavior: ScrollBehavior = reduce ? 'auto' : 'smooth';
    wrap.querySelector('.rail-prev')!.addEventListener('click', () => rail.scrollBy({ left: -stepFor(rail), behavior }));
    wrap.querySelector('.rail-next')!.addEventListener('click', () => rail.scrollBy({ left: stepFor(rail), behavior }));
    rail.addEventListener('scroll', () => updateRail(item), { passive: true });
    rail.addEventListener('keydown', (e) => {
      if (e.target !== rail) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); rail.scrollBy({ left: stepFor(rail), behavior }); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); rail.scrollBy({ left: -stepFor(rail), behavior }); }
    });
  });
  addEventListener('resize', () => items.forEach((i) => { if (i.classList.contains('open')) updateRail(i); }));

  /* deep link: /#print opens that category */
  const hashCat = items.find((i) => `#${i.dataset.cat}` === location.hash);
  if (hashCat) { setOpen(hashCat, true); setTimeout(() => hashCat.scrollIntoView({ block: 'start', behavior: 'smooth' }), 50); }
</script>
