---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { site, CATEGORIES } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => {
    const siblings = all.filter((e) => e.data.category === entry.data.category);
    const i = siblings.indexOf(entry);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: siblings[(i - 1 + siblings.length) % siblings.length],
        next: siblings[(i + 1) % siblings.length],
        index: i + 1,
        total: siblings.length,
      },
    };
  });
}

const { entry, prev, next, index, total } = Astro.props;
const w = entry.data;
const cat = CATEGORIES.find((c) => c.key === w.category)!;
const hero = w.hero ?? w.image;
const single = total <= 1;
---

<Base title={`${w.title}: ${site.name}`} description={w.summary ?? site.description} bodyClass="b-work" ogImage={new URL(hero, Astro.site).href}>
  <SiteHeader current="home" />

  <main class="proj wrap">
    <!-- ============ INTRO ============ -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Work</a>
      <span aria-hidden="true">/</span>
      <a href={`/#${cat.key}`}>{cat.label}</a>
    </nav>

    <header class="proj-head">
      <p class="eyebrow"><span class="ico"><CategoryIcon name={cat.icon} /></span>{cat.label}{w.client && <> <i>•</i> {w.client}</>}</p>
      <h1>{w.title}</h1>
      {w.summary && <p class="summary">{w.summary}</p>}
    </header>

    <dl class="meta">
      {w.client && <div><dt>Client</dt><dd>{w.client}</dd></div>}
      {w.role && <div><dt>Role</dt><dd>{w.role}</dd></div>}
      {w.year && <div><dt>Year</dt><dd>{w.year}</dd></div>}
      {w.deliverables.length > 0 && <div><dt>Deliverables</dt><dd>{w.deliverables.join(', ')}</dd></div>}
    </dl>

    <!-- ============ HERO IMAGE / VIDEO ============ -->
    <figure class="hero-img">
      {w.video
        ? <div class="video"><iframe src={w.video} title={w.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>
        : <img src={hero} alt={w.title} width="1600" height="900" loading="eager" decoding="async" />}
    </figure>

    <!-- ============ BODY ============ -->
    {w.body.length > 0 && (
      <section class="body">
        <h2 class="body-h">About the project</h2>
        <div class="body-copy">
          {w.body.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}

    <!-- ============ GALLERY ============ -->
    {w.gallery.length > 0 && (
      <section class="gal" aria-label="Project gallery">
        {w.gallery.map((g, i) => (
          <figure class:list={['gal-item', { wide: w.gallery.length % 2 === 1 && i === 0 }]}>
            <img src={g.src} alt={g.caption ?? `${w.title} image ${i + 1}`} loading="lazy" decoding="async" width="1200" height="900" />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <!-- ============ PREV / NEXT ============ -->
    <nav class="pn" aria-label="More projects">
      <a class:list={['pn-link pn-prev', { off: single }]} href={`/work/${prev.id}/`} aria-disabled={single}>
        <span class="pn-lab">← Previous</span>
        <span class="pn-title">{prev.data.title}</span>
      </a>
      <div class="pn-mid">
        <span class="pn-count">{index} / {total}</span>
        <a class="pn-all" href={`/#${cat.key}`}>All {cat.label.split(' and ')[0].toLowerCase()} work</a>
      </div>
      <a class:list={['pn-link pn-next', { off: single }]} href={`/work/${next.id}/`} aria-disabled={single}>
        <span class="pn-lab">Next →</span>
        <span class="pn-title">{next.data.title}</span>
      </a>
    </nav>
  </main>

  <SiteFooter />
</Base>

<style>
  .proj{padding-top:clamp(28px,4vw,56px);padding-bottom:20px}

  .crumbs{display:flex;gap:10px;font-size:12px;letter-spacing:.06em;color:var(--ink-soft)}
  .crumbs a:hover{color:var(--accent)}

  .proj-head{margin-top:clamp(28px,4vw,56px);max-width:820px}
  .proj-head .eyebrow{display:flex;align-items:center;gap:10px}
  .proj-head .eyebrow i{font-style:normal;margin:0 2px}
  .ico{display:inline-flex;color:var(--accent)}
  .ico :global(.cat-ico){width:16px;height:16px}
  h1{font-size:clamp(34px,5vw,64px);font-weight:400;letter-spacing:-.005em;line-height:1.08;margin-top:16px}
  .summary{margin-top:22px;font-size:clamp(17px,1.6vw,20px);font-weight:300;line-height:1.6;color:var(--ink-soft);max-width:640px}

  .meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:18px 32px;margin-top:clamp(28px,4vw,48px);padding-top:24px;border-top:1px solid var(--line-soft)}
  .meta dt{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--ink-faint);font-weight:500}
  .meta dd{margin-top:6px;font-size:15px}

  .hero-img{margin-top:clamp(28px,4vw,48px);background:var(--paper-3);border-radius:2px;overflow:hidden}
  .hero-img img{width:100%;aspect-ratio:16/9;object-fit:cover}
  .video{aspect-ratio:16/9;background:#000}
  .video iframe{width:100%;height:100%;border:0}

  .body{display:grid;grid-template-columns:1fr 2fr;gap:clamp(20px,4vw,64px);margin-top:clamp(40px,6vw,88px)}
  .body-h{font-size:clamp(24px,2.4vw,30px)}
  .body-copy p{font-size:16px;line-height:1.75;color:var(--ink);font-weight:300}
  .body-copy p+p{margin-top:1.1em}

  .gal{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:clamp(40px,6vw,88px)}
  .gal-item{border-radius:2px;overflow:hidden}
  .gal-item img{background:var(--paper-3)}
  .gal-item.wide{grid-column:1/-1}
  .gal-item img{width:100%;aspect-ratio:4/3;object-fit:cover}
  .gal-item.wide img{aspect-ratio:16/9}
  .gal-item figcaption{padding:10px 2px 0;font-size:12px;letter-spacing:.04em;color:var(--ink-soft)}

  .pn{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center;margin-top:clamp(56px,8vw,110px);padding-top:28px;border-top:1px solid var(--line)}
  .pn-link{display:flex;flex-direction:column;gap:6px;transition:color .15s}
  .pn-link:hover{color:var(--accent)}
  .pn-link.off{pointer-events:none;opacity:.35}
  .pn-next{text-align:right;align-items:flex-end}
  .pn-lab{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-faint);font-weight:500}
  .pn-title{font-family:var(--font-display);font-size:clamp(17px,1.8vw,21px)}
  .pn-mid{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
  .pn-count{font-size:12px;letter-spacing:.14em;color:var(--ink-faint);font-variant-numeric:tabular-nums}
  .pn-all{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);font-weight:500;white-space:nowrap}
  .pn-all:hover{text-decoration:underline;text-underline-offset:4px}

  @media (max-width:820px){
    .body{grid-template-columns:1fr;gap:16px}
    .gal{grid-template-columns:1fr}
    .gal-item.wide img{aspect-ratio:4/3}
    .pn{grid-template-columns:1fr 1fr;grid-template-areas:"prev next" "mid mid"}
    .pn-prev{grid-area:prev}.pn-next{grid-area:next}.pn-mid{grid-area:mid;margin-top:8px}
  }
</style>
