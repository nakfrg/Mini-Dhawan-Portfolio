---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, experience, qualifications, tools, stats } from '../data/site';
---

<Base title={`Resume: ${site.name}, ${site.role}`} bodyClass="b-resume">
  <SiteHeader current="resume" />
  <Hero />

  <main class="resume wrap" id="resume">
    <p class="eyebrow muted">My resume</p>
    <a class="eyebrow dl" href={site.resumePdf} download>Download a detailed version</a>

    <div class="cols">
      <!-- ============ EXPERIENCE ============ -->
      <section class="exp" aria-labelledby="exp-h">
        <h2 id="exp-h">Experience</h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <span class="tl-dot" aria-hidden="true"></span>
              <span class="tl-dates">{e.dates}</span>
              <span class="tl-role">{e.role}</span>
              <span class="tl-org">{e.org}</span>
            </li>
          ))}
        </ol>
      </section>

      <aside class="side">
        <!-- ============ QUALIFICATIONS ============ -->
        <section aria-labelledby="qual-h">
          <h2 id="qual-h">Qualifications</h2>
          <ul class="quals">
            {qualifications.map((q) => (
              <li><b>{q.title}</b><span>{q.dates}</span></li>
            ))}
          </ul>
        </section>

        <!-- ============ TOOLS ============ -->
        <section aria-labelledby="tools-h">
          <h2 id="tools-h">Tools</h2>
          <ul class="tools">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </section>
      </aside>
    </div>

    <!-- ============ STATS ============ -->
    <ul class="stats">
      {stats.map((s) => (
        <li><b>{s.value}</b><span>{s.label}</span></li>
      ))}
    </ul>
  </main>

  <SiteFooter />
</Base>

<style>
  .resume{padding-bottom:20px}
  .dl{display:block;margin-top:14px;font-weight:600;transition:opacity .15s}
  .dl:hover{opacity:.7}
  .cols{display:grid;grid-template-columns:1.45fr 1fr;gap:clamp(32px,6vw,90px);margin-top:44px}
  h2{font-size:clamp(28px,3vw,36px);font-weight:400;letter-spacing:.005em;margin-bottom:38px}

  /* timeline */
  .timeline{list-style:none;position:relative;padding-left:96px}
  .timeline::before{content:"";position:absolute;left:29px;top:12px;bottom:0;width:1px;background:var(--line)}
  .timeline li{position:relative;display:flex;flex-direction:column;padding-bottom:36px}
  .timeline li:last-child{padding-bottom:0}
  .tl-dot{position:absolute;left:-73px;top:6px;width:13px;height:13px;border-radius:50%;background:var(--paper);border:1px solid var(--accent);box-shadow:inset 0 0 0 3px var(--paper);}
  .tl-dot::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--accent)}
  .tl-dates{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);font-weight:500;line-height:1.5}
  .tl-role{font-size:18px;font-weight:500;line-height:1.5;color:var(--ink)}
  .tl-org{font-size:17px;font-weight:300;color:var(--ink-soft);line-height:1.5;max-width:26em}

  /* qualifications */
  .side{display:flex;flex-direction:column;gap:clamp(48px,6vw,90px)}
  .quals{list-style:none;display:flex;flex-direction:column;gap:20px}
  .quals li{background:var(--paper-3);border-radius:6px;padding:20px 26px 18px 76px;display:flex;flex-direction:column;gap:2px;line-height:1.35}
  .quals b{font-size:18px;font-weight:500}
  .quals span{font-size:15px;color:var(--ink-soft);font-weight:300}

  /* tools */
  .tools{list-style:none;display:flex;flex-wrap:wrap;gap:20px 20px}
  .tools li{border:1px solid var(--line);border-radius:5px;padding:16px 26px;font-size:17px;font-weight:400;min-width:158px;text-align:center;letter-spacing:.02em}

  /* stats */
  .stats{list-style:none;display:flex;justify-content:space-around;gap:24px;margin-top:clamp(64px,8vw,110px);padding-inline:clamp(0px,6vw,110px)}
  .stats li{display:flex;flex-direction:column;line-height:1.05}
  .stats b{font-size:clamp(28px,3vw,36px);font-weight:700;color:var(--accent);letter-spacing:.005em}
  .stats span{font-size:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-top:6px}

  @media (max-width:820px){
    .cols{grid-template-columns:1fr;gap:56px}
    .timeline{padding-left:52px}
    .timeline::before{left:7px}
    .tl-dot{left:-51px}
    .quals li{padding-left:26px}
    .stats{flex-direction:column;gap:28px;padding-inline:0}
  }
</style>
