---
/* Outline icons for the work accordion rows (Lucide-style, 24px grid). */
interface Props { name: 'flag' | 'monitor' | 'book' | 'play'; }
const { name } = Astro.props;
---
<svg class="cat-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'flag' && <><path d="M4 22V4a1 1 0 0 1 1-1h12.5l-3 5 3 5H5"/></>}
  {name === 'monitor' && <><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/></>}
  {name === 'book' && <><path d="M12 6c-1.5-1.3-3.5-2-6-2H4v14h2c2.5 0 4.5.7 6 2 1.5-1.3 3.5-2 6-2h2V4h-2c-2.5 0-4.5.7-6 2Z"/><path d="M12 6v14"/></>}
  {name === 'play' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m10 9 5 3-5 3V9Z"/></>}
</svg>
