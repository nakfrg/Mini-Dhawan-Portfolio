---
import { hero } from '../data/site';
---

<section class="hero wrap" id="top">
  <h1>{hero.lead} <span class="hl"><span class="hl-bg" aria-hidden="true"></span>{hero.highlight}</span></h1>
  <p class="tagline">{hero.tagline}</p>
</section>

<style>
  .hero{display:grid;grid-template-columns:1.6fr 1fr;gap:clamp(24px,5vw,80px);align-items:center;padding-top:clamp(56px,10vw,150px);padding-bottom:clamp(64px,11vw,170px)}
  h1{font-size:clamp(50px,7.6vw,96px);font-weight:400;letter-spacing:-.01em;line-height:1;white-space:nowrap}
  .hl{position:relative;display:inline-block;font-weight:400;padding:0 .12em 0 .08em;margin-left:.02em}
  .hl-bg{position:absolute;inset:.14em -.02em .04em -.04em;background:var(--highlight);transform:rotate(-1.4deg);border-radius:2px;z-index:-1}
  .tagline{font-size:clamp(16px,1.5vw,18px);line-height:1.6;color:var(--ink-soft);max-width:400px;font-weight:300}

  @media (max-width:820px){
    .hero{grid-template-columns:1fr;gap:28px;align-items:start}
    h1{white-space:normal}
  }
</style>
